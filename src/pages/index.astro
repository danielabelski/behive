    class="fixed bottom-6 right-6 z-50 w-10 h-10 rounded-full bg-surface border border-gold-muted/30 flex items-center justify-center text-gold hover:bg-gold hover:text-black transition-all opacity-0 pointer-events-none"
    aria-label="Scroll to top"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
  </button>

  <script>
    // Mobile nav toggle
    const toggle = document.getElementById('mobile-toggle');
    const nav = document.getElementById('mobile-nav');
    const setMenuOpen = (open: boolean) => {
      nav?.classList.toggle('open', open);
      if (nav) nav.inert = !open;
      toggle?.setAttribute('aria-expanded', String(open));
    };
    toggle?.addEventListener('click', () => setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenuOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        toggle.focus();
      }
    });
    
    // Scroll to top
    const btn = document.getElementById('scroll-top');
    window.addEventListener('scroll', () => {
      if (!btn) return;
      if (window.scrollY > 600) {
        btn.style.opacity = '1';
        btn.style.pointerEvents = 'auto';
      } else {
        btn.style.opacity = '0';
        btn.style.pointerEvents = 'none';
      }
    });
    btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  </script>
