---
import Layout from '../layouts/Layout.astro'
import HexGrid from '../components/HexGrid.tsx'
import MagnetLines from '../components/MagnetLines.tsx'
import MatrixRain from '../components/MatrixRain.tsx'
import KineticReveal from '../components/KineticReveal.tsx'
import VelocityScroll from '../components/VelocityScroll.tsx'
import FadeIn from '../components/FadeIn.tsx'
import CopyButton from '../components/CopyButton.tsx'
import TypeWriter from '../components/TypeWriter.tsx'
---

<Layout>
  <!-- ═══════════════════ NAV ═══════════════════ -->
  <nav class="fixed top-0 w-full z-50 backdrop-blur-xl bg-black/70 border-b border-gold-muted/15">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <img src="/images/behive_logo_pixelbee_primary.png" alt="BeHive" class="w-8 h-8 pixel-render group-hover:scale-110 transition-transform" />
        <span class="font-mono font-bold text-gold-bright text-lg tracking-tight">BeHive</span>
      </a>
      <div class="hidden md:flex items-center gap-8 text-sm font-mono">
        <a href="#how-it-works" class="text-muted hover:text-gold transition-colors link-underline">How It Works</a>
        <a href="#capabilities" class="text-muted hover:text-gold transition-colors link-underline">Capabilities</a>
        <a href="#integrations" class="text-muted hover:text-gold transition-colors link-underline">Integrations</a>
        <a href="https://github.com/qa10devteam/behive" target="_blank" rel="noopener" class="text-muted hover:text-gold transition-colors flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
      <div class="flex items-center gap-4">
        <a href="#install" class="bg-gold hover:bg-gold-bright text-black font-mono font-bold text-sm px-5 py-2.5 rounded transition-all hover:shadow-[0_0_20px_rgba(245,166,35,0.3)]">
          Get Started
        </a>
        <!-- Mobile menu button -->
        <button id="mobile-toggle" class="md:hidden text-muted hover:text-gold" aria-label="Menu" aria-controls="mobile-nav" aria-expanded="false">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <!-- Mobile nav -->
    <div id="mobile-nav" inert class="mobile-nav fixed top-16 right-0 h-[calc(100dvh-4rem)] overflow-y-auto w-64 bg-surface/95 backdrop-blur-xl border-l border-gold-muted/20 p-6 md:hidden">
      <div class="flex flex-col gap-6 font-mono text-sm">
        <a href="#how-it-works" class="text-muted hover:text-gold transition-colors">How It Works</a>
        <a href="#capabilities" class="text-muted hover:text-gold transition-colors">Capabilities</a>
        <a href="#integrations" class="text-muted hover:text-gold transition-colors">Integrations</a>
        <a href="https://github.com/qa10devteam/behive" target="_blank" class="text-muted hover:text-gold transition-colors">GitHub</a>
        <a href="https://pypi.org/project/behive" target="_blank" class="text-muted hover:text-gold transition-colors">PyPI</a>
      </div>
    </div>
  </nav>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16 noise-overlay">
    <HexGrid client:load />
    <MagnetLines client:load rows={8} cols={15} />
    
    <div class="relative z-10 w-full min-w-0 max-w-5xl mx-auto px-6 text-center">
      <!-- Badge -->
      <FadeIn client:load delay={0}>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-gold-muted/30 bg-surface/50 backdrop-blur-sm mb-8">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
          </span>
          <span class="text-xs font-mono text-muted">v0.6.0 — Open Source (MIT)</span>
        </div>
      </FadeIn>
      
      <!-- Headline -->
      <KineticReveal 
        client:load 
        text="Structured knowledge," 
        className="text-4xl sm:text-5xl md:text-7xl font-mono font-extrabold text-gold-bright justify-center leading-none"
        delay={0.3}
      />
      <KineticReveal 
        client:load 
        text="not text soup." 
        className="text-4xl sm:text-5xl md:text-7xl font-mono font-extrabold text-text mt-2 md:mt-4 justify-center leading-none"
        delay={0.8}
      />
      
      <!-- Subheadline -->
      <FadeIn client:load delay={1.4}>
        <p class="mt-8 md:mt-10 text-base md:text-xl text-text-dim max-w-2xl mx-auto leading-relaxed">
          Feed it a question. Get back{' '}<span class="text-gold font-medium">scored claims</span>,{' '}<span class="text-info font-medium">entity graphs</span>, and a{' '}<span class="text-success font-medium">synthesized report</span>{' '}— using your own LLM.
        </p>
      </FadeIn>
      
      <!-- Dynamic tagline -->
      <FadeIn client:load delay={1.6}>
        <p class="mt-4 text-sm font-mono text-gold-muted">
          Research <TypeWriter client:load words={['NVIDIA GPU market', 'EU AI Act enforcement', 'Meta Llama architecture', 'public procurement intel', 'competitor analysis']} />
        </p>
      </FadeIn>
      
      <!-- CTA -->
      <FadeIn client:load delay={1.8}>
        <div class="mt-10 md:mt-12 flex flex-col sm:flex-row items-center justify-center gap-4" id="install">
          <div class="flex items-center gap-3 bg-surface border border-gold-muted/40 rounded px-6 py-3 font-mono text-sm group hover:border-gold/60 transition-all hover:shadow-[0_0_20px_rgba(245,166,35,0.1)]">
            <span class="text-muted">$</span>
            <code class="text-gold-bright">pip install behive==0.6.0</code>
            <CopyButton client:load text="pip install behive==0.6.0" />
          </div>
          <a href="https://github.com/qa10devteam/behive" target="_blank" rel="noopener" class="flex items-center gap-2 border border-muted/30 rounded px-6 py-3 font-mono text-sm text-muted hover:text-text hover:border-muted/60 transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            View on GitHub
          </a>
        </div>
      </FadeIn>
      
      <!-- Schematic terminal -->
      <FadeIn client:load delay={2.0}>
        <div class="mt-12 md:mt-16 rounded border border-gold-muted/30 overflow-hidden shadow-2xl shadow-gold/5 glow-pulse max-w-4xl mx-auto">
          <div class="flex items-center gap-2 px-4 py-2.5 bg-surface/80 border-b border-gold-muted/20">
            <div class="w-3 h-3 rounded-full bg-error/70"></div>
            <div class="w-3 h-3 rounded-full bg-amber/70"></div>
            <div class="w-3 h-3 rounded-full bg-success/70"></div>
            <span class="ml-3 text-xs font-mono text-muted truncate">Schematic example — not a research result</span>
          </div>
          <pre class="p-5 md:p-8 text-left font-mono text-xs md:text-sm text-text-dim overflow-x-auto leading-relaxed"><code>{`$ behive research "your research question" --depth 3 --no-db

Scout → Harvest → Extract → Synthesize

claim       source-linked statement
score       heuristic quality signal
entities    extracted names and relationships
report      model-generated synthesis

Illustration only. No live mission runs on this page.`}</code></pre>
        </div>
      </FadeIn>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-5 h-5 text-gold-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
    </div>
  </section>

  <!-- ═══ Separator ═══ -->
  <div class="gold-separator"></div>

  <!-- ═══════════════════ OUTPUTS ═══════════════════ -->
  <section class="py-16 px-6 bg-surface/20">
    <div class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {[
        { title: 'Claims', detail: 'Scored, source-linked statements' },
        { title: 'Entities', detail: 'Names and relationships' },
        { title: 'Reports', detail: 'Model-generated synthesis' },
        { title: 'History', detail: 'Persisted research missions' },
      ].map((item, i) => (
        <FadeIn client:visible delay={i * 0.1}>
          <div class="text-xl md:text-2xl font-mono font-bold text-gold-bright">{item.title}</div>
          <p class="text-xs font-mono text-muted mt-2">{item.detail}</p>
        </FadeIn>
      ))}
    </div>
  </section>

  <!-- ═══ Separator ═══ -->
  <div class="gold-separator"></div>

  <!-- ═══════════════════ VELOCITY SCROLL ═══════════════════ -->
  <VelocityScroll 
    client:visible 
    texts={['MCP Native', 'API Sources', 'Knowledge Graph', 'Quality Scoring', 'Self-Hosted', 'MIT License', 'SSE Streaming', 'BYOK LLM', 'PostgreSQL', 'Docker Compose', 'Claim Search', 'Entity Networks']}
    className="py-6 bg-black/50"
  />

  <!-- ═══════════════════ PROBLEM ═══════════════════ -->
  <section class="py-24 md:py-32 px-6">
    <div class="max-w-5xl mx-auto">
      <FadeIn client:visible>
        <p class="font-mono text-xs text-gold uppercase tracking-[0.3em] mb-4">The Problem — schematic comparison</p>
      </FadeIn>
      <FadeIn client:visible delay={0.1}>
        <h2 class="text-2xl sm:text-3xl md:text-5xl font-mono font-bold text-text leading-tight">
          You ask AI to research a topic.<br/>
          <span class="text-muted">It gives you confident-sounding<br class="hidden sm:block"/>text soup.</span>
        </h2>
      </FadeIn>
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 mt-12 md:mt-16">
        <FadeIn client:visible delay={0.2}>
          <div class="p-6 border border-error/20 rounded bg-error/5 card-hover">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-6 h-6 rounded-full bg-error/20 flex items-center justify-center text-xs">✗</span>
              <p class="font-mono text-sm text-error font-medium">Unstructured answer</p>
            </div>
            <p class="text-text-dim leading-relaxed text-sm md:text-base italic">
              "Based on my training data, NVIDIA's GPU market shows promising growth with several key factors driving demand..."
            </p>
            <div class="mt-5 pt-4 border-t border-error/10 flex flex-wrap gap-3 text-xs font-mono text-muted">
              <span class="px-2 py-0.5 rounded-sm bg-error/10 text-error/70">No sources</span>
              <span class="px-2 py-0.5 rounded-sm bg-error/10 text-error/70">No structure</span>
              <span class="px-2 py-0.5 rounded-sm bg-error/10 text-error/70">Stale data</span>
            </div>
          </div>
        </FadeIn>
        <FadeIn client:visible delay={0.3}>
          <div class="p-6 border border-success/20 rounded bg-success/5 card-hover">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-6 h-6 rounded-full bg-success/20 flex items-center justify-center text-xs">✓</span>
              <p class="font-mono text-sm text-success font-medium">Schematic BeHive artifacts</p>
            </div>
            <div class="text-text-dim leading-relaxed text-sm md:text-base space-y-2">
              <p><span class="text-gold font-mono font-bold">[claim]</span> Example claim → original source URL</p>
              <p><span class="text-gold font-mono font-bold">[entity]</span> Example entity → linked research mission</p>
              <p><span class="text-gold font-mono font-bold">[link]</span> Example relationship → supporting claim</p>
            </div>
            <div class="mt-5 pt-4 border-t border-success/10 flex flex-wrap gap-3 text-xs font-mono text-muted">
              <span class="px-2 py-0.5 rounded-sm bg-success/10 text-success/70">Source links</span>
              <span class="px-2 py-0.5 rounded-sm bg-success/10 text-success/70">Stored artifacts</span>
              <span class="px-2 py-0.5 rounded-sm bg-success/10 text-success/70">Review required</span>
            </div>
          </div>
        </FadeIn>
      </div>
    </div>
  </section>

  <!-- ═══ Separator ═══ -->
  <div class="gold-separator"></div>

  <!-- ═══════════════════ HOW IT WORKS ═══════════════════ -->
  <section id="how-it-works" class="py-24 md:py-32 px-6 relative">
    <div class="absolute inset-0 hex-bg"></div>
    <div class="relative max-w-5xl mx-auto">
      <FadeIn client:visible>
        <p class="font-mono text-xs text-gold uppercase tracking-[0.3em] mb-4">How It Works</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-mono font-bold text-text">
          Swarm intelligence.<br/>
          <span class="text-gold">Not prompt engineering.</span>
        </h2>
      </FadeIn>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 mt-12 md:mt-16">
        {[
          { icon: '🐝', step: '01', title: 'Scout', desc: 'The planner breaks a topic into research tasks. Search backends and topic-specific API adapters discover candidate sources.', color: 'gold' },
          { icon: '⬡', step: '02', title: 'Harvest', desc: 'Fetch candidate pages and documents with configured HTTP or optional browser backends. Some sources need credentials or extra dependencies.', color: 'amber' },
          { icon: '⚗️', step: '03', title: 'Extract', desc: 'Your configured model extracts claims from source content. Quality heuristics help rank extracted statements for review.', color: 'info' },
          { icon: '🧬', step: '04', title: 'Deduplicate', desc: 'Similarity checks reduce repeated claims. Deduplication is heuristic: similar statements can still need human review.', color: 'gold-bright' },
          { icon: '📊', step: '05', title: 'Synthesize', desc: 'Your configured model synthesizes extracted claims into a report. Check its conclusions against the linked original sources.', color: 'success' },
          { icon: '🕸️', step: '06', title: 'Graph', desc: 'Persist claims, entities, and relationships. The PostgreSQL-backed API exposes entity and network lookups across missions.', color: 'info' },
        ].map((item, i) => (
          <FadeIn client:visible delay={i * 0.1}>
            <div class="p-6 border border-gold-muted/20 rounded bg-surface/50 card-hover group relative overflow-hidden">
              <!-- Step number background -->
              <span class="absolute -top-2 -right-2 text-6xl font-mono font-black text-gold-muted/5 select-none">{item.step}</span>
              <div class="relative">
                <div class="flex items-center gap-3 mb-4">
                  <span class="text-2xl">{item.icon}</span>
                  <span class="font-mono text-[10px] text-gold-muted uppercase tracking-widest">Step {item.step}</span>
                </div>
                <h3 class="font-mono font-bold text-lg text-gold-bright group-hover:text-gold-bright mb-3">{item.title}</h3>
                <p class="text-sm text-text-dim leading-relaxed">{item.desc}</p>
              </div>
            </div>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Separator ═══ -->
  <div class="gold-separator"></div>

  <!-- ═══════════════════ CAPABILITIES ═══════════════════ -->
  <section id="capabilities" class="py-24 md:py-32 px-6 bg-surface/30">
    <div class="max-w-5xl mx-auto">
      <FadeIn client:visible>
        <p class="font-mono text-xs text-gold uppercase tracking-[0.3em] mb-4">Capabilities</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-mono font-bold text-text">
          Research artifacts. <span class="text-muted">Not performance promises.</span>
        </h2>
        <p class="mt-4 text-text-dim text-sm md:text-base">Available interfaces in v0.6.0. Results depend on source access, configuration, and your model.</p>
      </FadeIn>
      <FadeIn client:visible delay={0.2}>
        <div class="mt-10 md:mt-12 overflow-x-auto rounded border border-gold-muted/15">
          <table class="w-full text-sm font-mono">
            <thead><tr class="bg-surface/50">
              <th class="text-left py-3.5 px-4 text-gold">Artifact</th>
              <th class="text-left py-3.5 px-4 text-gold">What you can do</th>
            </tr></thead>
            <tbody>
              {[
                { artifact: 'Claims', detail: 'Search saved claims and inspect their scores and sources.' },
                { artifact: 'Mission status', detail: 'Poll progress or subscribe to API server-sent events.' },
                { artifact: 'Report', detail: 'Retrieve the synthesized report for a completed mission.' },
                { artifact: 'Entity network', detail: 'Explore stored entities and relationships through the API.' },
                { artifact: 'Mission history', detail: 'List saved missions and reuse the knowledge store.' },
              ].map(row => (
                <tr class="border-t border-gold-muted/10 table-row-hover">
                  <td class="py-3 px-4 text-text">{row.artifact}</td>
                  <td class="py-3 px-4 text-text-dim">{row.detail}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </FadeIn>
      <FadeIn client:visible delay={0.3}>
        <p class="mt-6 text-xs text-muted font-mono text-center leading-relaxed">
          A quality score is a heuristic, not a probability of truth.<br class="hidden sm:block"/>
          Check original sources. Extraction and synthesis can be incomplete or incorrect.
        </p>
      </FadeIn>
    </div>
  </section>

  <!-- ═══ Separator ═══ -->
  <div class="gold-separator"></div>

  <!-- ═══════════════════ INTEGRATIONS ═══════════════════ -->
  <section id="integrations" class="py-24 md:py-32 px-6">
    <div class="max-w-5xl mx-auto">
      <FadeIn client:visible>
        <p class="font-mono text-xs text-gold uppercase tracking-[0.3em] mb-4">Integrations</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-mono font-bold text-text">
          Works with your <span class="text-gold">existing stack.</span>
        </h2>
      </FadeIn>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6 mt-10 md:mt-12">
        {[
          { name: 'Terminal', method: 'CLI', desc: 'Run missions with depth, scale, and local or remote storage options.', emoji: '⌨️' },
          { name: 'HTTP clients', method: 'REST API', desc: 'Start research, poll status, and retrieve reports or stored claims.', emoji: '🔌' },
          { name: 'Progress viewers', method: 'Server-sent events', desc: 'Subscribe to the API mission events endpoint.', emoji: '⚡' },
          { name: 'MCP clients', method: 'JSON-RPC over HTTP', desc: 'Connect to the /mcp endpoint using client-specific configuration. Compatibility must be checked with your client.', emoji: '🤖' },
          { name: 'Python applications', method: 'BeHiveClient', desc: 'Use the packaged client for local or remote research.', emoji: '🐍' },
          { name: 'Knowledge tools', method: 'Entity + network API', desc: 'Query the PostgreSQL-backed knowledge store across missions.', emoji: '🕸️' },
        ].map((item, i) => (
          <FadeIn client:visible delay={i * 0.08}>
            <div class="p-5 border border-gold-muted/20 rounded bg-surface/30 card-hover group">
              <div class="flex items-center gap-3">
                <span class="text-xl">{item.emoji}</span>
                <h3 class="font-mono font-bold text-text group-hover:text-gold-bright transition-colors">{item.name}</h3>
              </div>
              <p class="text-xs font-mono text-gold mt-2">{item.method}</p>
              <p class="text-sm text-text-dim mt-2 leading-relaxed">{item.desc}</p>
            </div>
          </FadeIn>
        ))}
      </div>
      
      <FadeIn client:visible delay={0.5}>
        <div class="mt-10 md:mt-12 p-5 md:p-6 border border-gold-muted/20 rounded bg-surface/30 glow-border">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2 h-2 rounded-full bg-gold"></span>
            <p class="font-mono text-sm text-text-dim">MCP endpoint <span class="text-muted">(JSON-RPC over HTTP)</span></p>
          </div>
          <p class="text-sm text-text-dim mb-4">Start the service below, then connect to http://127.0.0.1:8090/mcp. Configuration is client-specific; this is not a universal desktop-client config.</p>
          <pre class="font-mono text-xs md:text-sm text-gold overflow-x-auto leading-relaxed"><code>{`curl http://127.0.0.1:8090/mcp \
  -H 'Content-Type: application/json' \
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}'`}</code></pre>
          <p class="mt-4 text-xs font-mono text-muted">Tools: research_topic, search_knowledge, mission_status, get_report, list_missions. API mission progress uses SSE; the MCP bridge responds with JSON.</p>
          <p class="mt-3 text-xs font-mono text-muted">Current bridge limitation: it does not forward API credentials, so research_topic cannot start an authenticated API mission when BEHIVE_API_KEY is enabled. Use the authenticated REST API for that setup.</p>
        </div>
      </FadeIn>
    </div>
  </section>

  <!-- ═══ Separator ═══ -->
  <div class="gold-separator"></div>

  <!-- ═══════════════════ SELF-HOSTING ═══════════════════ -->
  <section id="setup" class="py-24 md:py-32 px-6 bg-surface/30">
    <div class="max-w-4xl mx-auto">
      <FadeIn client:visible>
        <p class="font-mono text-xs text-gold uppercase tracking-[0.3em] mb-4">Self-Hosting</p>
